{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-data-suite.github.io/pds-portia/schemas/v3/event-participant-role.schema.json",
  "title": "Portia Event Participant Role v3",
  "description": "Canonical Portia Event Participant Role version-3 record. Version 3 preserves version-2 target, role-type, basis, contextual-detail, provenance, and lifecycle semantics while making successor lineage exact and cross-work capable.",
  "$comment": "Application validation remains responsible for storage and envelope scope, parent Event and Participant resolution, basis resolution, paper provenance agreement, timestamp chronology, lifecycle legality, active-role compatibility, exact ownership-correction and migration reconciliation, no silent retargeting, and atomic or recoverable multi-record operations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "module_id",
    "class_id",
    "work_id",
    "role_id",
    "target",
    "status",
    "role_type",
    "creation_source",
    "created_at",
    "created_by",
    "updated_at",
    "updated_by"
  ],
  "properties": {
    "schema_version": {
      "const": "3"
    },
    "record_type": {
      "const": "event_participant_role"
    },
    "module_id": {
      "const": "portia"
    },
    "class_id": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/structurally-safe-external-id.schema.json"
    },
    "work_id": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-event-id.schema.json"
    },
    "role_id": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-event-participant-role-id.schema.json"
    },
    "target": {
      "$ref": "#/$defs/singularParticipantTarget"
    },
    "status": {
      "enum": [
        "proposed",
        "active",
        "invalidated",
        "superseded"
      ]
    },
    "role_type": {
      "enum": [
        "directly_involved",
        "present",
        "reported_involved",
        "contextual"
      ]
    },
    "basis": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/basisEntry"
      }
    },
    "detail": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/non-empty-text.schema.json"
    },
    "supersedes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/roleSupersessionRef"
      }
    },
    "creation_source": {
      "allOf": [
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/provenance/creation-source.schema.json"
        },
        {
          "not": {
            "properties": {
              "type": {
                "const": "paper_capture"
              },
              "stage": {
                "const": "preallocated"
              }
            },
            "required": [
              "type",
              "stage"
            ]
          }
        }
      ]
    },
    "created_at": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/explicit-offset-timestamp.schema.json"
    },
    "created_by": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/attribution/attribution-agent.schema.json"
    },
    "updated_at": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/explicit-offset-timestamp.schema.json"
    },
    "updated_by": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/attribution/attribution-agent.schema.json"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "role_type": {
            "const": "contextual"
          }
        },
        "required": [
          "role_type"
        ]
      },
      "then": {
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "active",
                    "superseded"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "detail"
              ]
            }
          }
        ]
      },
      "else": {
        "not": {
          "required": [
            "detail"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "role_type": {
            "const": "reported_involved"
          }
        },
        "required": [
          "role_type"
        ]
      },
      "then": {
        "required": [
          "basis"
        ],
        "properties": {
          "basis": {
            "contains": {
              "anyOf": [
                {
                  "$ref": "#/$defs/accountRefBasis"
                },
                {
                  "$ref": "#/$defs/paperCaptureBasis"
                },
                {
                  "$ref": "#/$defs/importSourceBasis"
                }
              ]
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "role_type": {
                "const": "reported_involved"
              }
            },
            "required": [
              "role_type"
            ]
          },
          {
            "properties": {
              "status": {
                "enum": [
                  "active",
                  "superseded"
                ]
              }
            },
            "required": [
              "status"
            ]
          }
        ]
      },
      "then": {
        "required": [
          "basis"
        ],
        "properties": {
          "basis": {
            "contains": {
              "$ref": "#/$defs/accountRefBasis"
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "creation_source": {
            "properties": {
              "type": {
                "const": "paper_capture"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "required": [
          "creation_source"
        ]
      },
      "then": {
        "required": [
          "basis"
        ],
        "properties": {
          "basis": {
            "contains": {
              "$ref": "#/$defs/paperCaptureBasis"
            },
            "minContains": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "participantRecordRef": {
      "allOf": [
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/local-record-ref.schema.json"
        },
        {
          "properties": {
            "record_kind": {
              "const": "event_participant"
            },
            "record_id": {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-event-participant-id.schema.json"
            },
            "contract_version": {
              "enum": [
                "1",
                "2",
                "3"
              ]
            }
          },
          "required": [
            "record_kind",
            "record_id",
            "contract_version"
          ]
        }
      ]
    },
    "singularParticipantTarget": {
      "allOf": [
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/targets/portia-target-ref.schema.json"
        },
        {
          "properties": {
            "kind": {
              "const": "event_participant"
            },
            "record_ref": {
              "$ref": "#/$defs/participantRecordRef"
            }
          },
          "required": [
            "kind",
            "record_ref"
          ]
        }
      ]
    },
    "accountRecordRef": {
      "allOf": [
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/local-record-ref.schema.json"
        },
        {
          "properties": {
            "record_kind": {
              "const": "account"
            },
            "record_id": {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/structurally-safe-external-id.schema.json"
            }
          },
          "required": [
            "record_kind",
            "record_id",
            "contract_version"
          ]
        }
      ]
    },
    "observationRecordRef": {
      "allOf": [
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/local-record-ref.schema.json"
        },
        {
          "properties": {
            "record_kind": {
              "const": "observation"
            },
            "record_id": {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/structurally-safe-external-id.schema.json"
            }
          },
          "required": [
            "record_kind",
            "record_id",
            "contract_version"
          ]
        }
      ]
    },
    "basisEntry": {
      "oneOf": [
        {
          "$ref": "#/$defs/accountRefBasis"
        },
        {
          "$ref": "#/$defs/observationRefBasis"
        },
        {
          "$ref": "#/$defs/paperCaptureBasis"
        },
        {
          "$ref": "#/$defs/importSourceBasis"
        }
      ]
    },
    "accountRefBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "record_ref"
      ],
      "properties": {
        "kind": {
          "const": "account_ref"
        },
        "record_ref": {
          "$ref": "#/$defs/accountRecordRef"
        }
      }
    },
    "observationRefBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "record_ref"
      ],
      "properties": {
        "kind": {
          "const": "observation_ref"
        },
        "record_ref": {
          "$ref": "#/$defs/observationRecordRef"
        }
      }
    },
    "paperCaptureBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "route_id",
        "page_record_id"
      ],
      "properties": {
        "kind": {
          "const": "paper_capture"
        },
        "route_id": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/structurally-safe-external-id.schema.json"
        },
        "page_record_id": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/structurally-safe-external-id.schema.json"
        }
      }
    },
    "importSourceBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source_label"
      ],
      "properties": {
        "kind": {
          "const": "import_source"
        },
        "source_label": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/non-empty-text.schema.json"
        },
        "source_record_id": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/non-empty-text.schema.json"
        }
      }
    },
    "roleWorkRecordRef": {
      "allOf": [
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-portia-work-record-ref.schema.json"
        },
        {
          "properties": {
            "record_ref": {
              "allOf": [
                {
                  "properties": {
                    "record_kind": {
                      "const": "event_participant_role"
                    },
                    "record_id": {
                      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-event-participant-role-id.schema.json"
                    },
                    "contract_version": {
                      "enum": [
                        "1",
                        "2",
                        "3"
                      ]
                    }
                  }
                },
                {
                  "required": [
                    "record_kind",
                    "record_id",
                    "contract_version"
                  ]
                }
              ]
            }
          },
          "required": [
            "work_ref",
            "record_ref"
          ]
        }
      ]
    },
    "roleSupersessionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_record_ref",
        "reason"
      ],
      "properties": {
        "work_record_ref": {
          "$ref": "#/$defs/roleWorkRecordRef"
        },
        "reason": {
          "enum": [
            "participant_corrected",
            "role_type_corrected",
            "basis_corrected",
            "detail_corrected",
            "duplicate_consolidated",
            "role_relationship_corrected",
            "work_root_corrected",
            "contract_migrated",
            "other"
          ]
        },
        "detail": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/non-empty-text.schema.json"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reason": {
                "const": "other"
              }
            },
            "required": [
              "reason"
            ]
          },
          "then": {
            "required": [
              "detail"
            ]
          }
        }
      ]
    }
  },
  "x-portia-application-invariants": [
    "portia.role_v3.canonical_storage_scope",
    "portia.role_v3.parent_event_resolution",
    "portia.role_v3.target_resolution",
    "portia.role_v3.target_same_event",
    "portia.role_v3.basis_resolution",
    "portia.role_v3.paper_provenance_agreement",
    "portia.role_v3.timestamp_chronology",
    "portia.role_v3.lifecycle_matrix",
    "portia.role_v3.self_supersession",
    "portia.role_v3.duplicate_predecessor",
    "portia.role_v3.supersession_cycle",
    "portia.role_v3.same_family_predecessor",
    "portia.role_v3.cross_work_requires_ownership_reason",
    "portia.role_v3.ownership_reason_requires_cross_work",
    "portia.role_v3.ownership_reconciliation",
    "portia.role_v3.migration_identity_preservation",
    "portia.role_v3.migration_same_work",
    "portia.role_v3.migration_reconciliation",
    "portia.role_v3.no_silent_retarget"
  ]
}
