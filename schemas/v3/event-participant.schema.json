{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-data-suite.github.io/pds-portia/schemas/v3/event-participant.schema.json",
  "title": "Portia Event Participant v3",
  "description": "Canonical Portia Event Participant version-3 record. Version 3 preserves version-2 subject and lifecycle semantics while making successor lineage exact, contract-versioned, and cross-work capable for governed ownership correction and representation-only migration.",
  "$comment": "Application validation remains responsible for canonical storage-path agreement; parent Event resolution and lifecycle eligibility; durable subject resolution and active uniqueness; transition legality; replacement reconciliation; exact cross-work ownership-correction lineage; migration identity preservation; no silent retargeting; and atomic or recoverable coordinated operations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "module_id",
    "class_id",
    "work_id",
    "participant_id",
    "status",
    "subject",
    "creation_source",
    "created_at",
    "created_by",
    "updated_at",
    "updated_by"
  ],
  "properties": {
    "schema_version": {
      "const": "3"
    },
    "record_type": {
      "const": "event_participant"
    },
    "module_id": {
      "const": "portia"
    },
    "class_id": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/structurally-safe-external-id.schema.json"
    },
    "work_id": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-event-id.schema.json"
    },
    "participant_id": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-event-participant-id.schema.json"
    },
    "status": {
      "enum": [
        "proposed",
        "active",
        "invalidated",
        "superseded"
      ]
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "supersedes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/participantSupersessionRef"
      },
      "description": "Canonical forward replacement links to exact prior Event Participant representations. Complete work-record references permit governed cross-root ownership correction without changing resolution semantics."
    },
    "creation_source": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/provenance/creation-source.schema.json"
    },
    "created_at": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/explicit-offset-timestamp.schema.json"
    },
    "created_by": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/attribution/attribution-agent.schema.json"
    },
    "updated_at": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/explicit-offset-timestamp.schema.json"
    },
    "updated_by": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/attribution/attribution-agent.schema.json"
    }
  },
  "$defs": {
    "subject": {
      "oneOf": [
        {
          "$ref": "#/$defs/rosterStudentSubject"
        },
        {
          "$ref": "#/$defs/actorSubject"
        },
        {
          "$ref": "#/$defs/descriptivePersonSubject"
        },
        {
          "$ref": "#/$defs/unknownPersonSubject"
        }
      ]
    },
    "rosterStudentSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "roster_student_ref",
        "display_snapshot"
      ],
      "properties": {
        "kind": {
          "const": "roster_student"
        },
        "roster_student_ref": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/roster-student-ref.schema.json"
        },
        "display_snapshot": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/snapshots/person-display-snapshot.schema.json"
        }
      }
    },
    "actorSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "actor_ref",
        "display_snapshot"
      ],
      "properties": {
        "kind": {
          "const": "actor"
        },
        "actor_ref": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/actor-ref.schema.json"
        },
        "display_snapshot": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/snapshots/person-display-snapshot.schema.json"
        }
      }
    },
    "descriptivePersonSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "description_type",
        "display_label"
      ],
      "properties": {
        "kind": {
          "const": "descriptive_person"
        },
        "description_type": {
          "enum": [
            "outside_student",
            "family_member",
            "school_staff",
            "visitor",
            "community_member",
            "other"
          ]
        },
        "display_label": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/non-empty-text.schema.json"
        },
        "detail": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/non-empty-text.schema.json"
        }
      },
      "$comment": "Application validation should require adequate clarification when description_type is other; display_label may itself provide that clarification."
    },
    "unknownPersonSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reason"
      ],
      "properties": {
        "kind": {
          "const": "unknown_person"
        },
        "reason": {
          "enum": [
            "identity_not_known",
            "identity_not_reported",
            "identity_withheld",
            "ambiguous_source",
            "ambiguous_paper_mark",
            "legacy_import"
          ]
        },
        "description": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/non-empty-text.schema.json"
        }
      }
    },
    "participantWorkRecordRef": {
      "allOf": [
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-portia-work-record-ref.schema.json"
        },
        {
          "properties": {
            "record_ref": {
              "allOf": [
                {
                  "properties": {
                    "record_kind": {
                      "const": "event_participant"
                    },
                    "record_id": {
                      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-event-participant-id.schema.json"
                    },
                    "contract_version": {
                      "enum": [
                        "1",
                        "2",
                        "3"
                      ]
                    }
                  }
                },
                {
                  "required": [
                    "record_kind",
                    "record_id",
                    "contract_version"
                  ]
                }
              ]
            }
          },
          "required": [
            "work_ref",
            "record_ref"
          ]
        }
      ]
    },
    "participantSupersessionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_record_ref",
        "reason"
      ],
      "properties": {
        "work_record_ref": {
          "$ref": "#/$defs/participantWorkRecordRef"
        },
        "reason": {
          "enum": [
            "identity_resolved",
            "identity_corrected",
            "duplicate_consolidated",
            "subject_variant_changed",
            "participant_relationship_corrected",
            "work_root_corrected",
            "contract_migrated",
            "other"
          ]
        },
        "detail": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/non-empty-text.schema.json"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reason": {
                "const": "other"
              }
            },
            "required": [
              "reason"
            ]
          },
          "then": {
            "required": [
              "detail"
            ]
          }
        }
      ],
      "description": "Exact forward replacement reference to a prior Event Participant representation. work_root_corrected is reserved for governed cross-work ownership correction; contract_migrated is reserved for representation-only migration."
    }
  },
  "x-portia-application-invariants": [
    "portia.participant_v3.canonical_storage_scope",
    "portia.participant_v3.parent_event_resolution",
    "portia.participant_v3.durable_subject_resolution",
    "portia.participant_v3.active_subject_uniqueness",
    "portia.participant_v3.timestamp_chronology",
    "portia.participant_v3.lifecycle_matrix",
    "portia.participant_v3.self_supersession",
    "portia.participant_v3.duplicate_predecessor",
    "portia.participant_v3.supersession_cycle",
    "portia.participant_v3.same_family_predecessor",
    "portia.participant_v3.cross_work_requires_ownership_reason",
    "portia.participant_v3.ownership_reason_requires_cross_work",
    "portia.participant_v3.ownership_reconciliation",
    "portia.participant_v3.migration_identity_preservation",
    "portia.participant_v3.migration_same_work",
    "portia.participant_v3.migration_reconciliation",
    "portia.participant_v3.no_silent_retarget"
  ]
}
