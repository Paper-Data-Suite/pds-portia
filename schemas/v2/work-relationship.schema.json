{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-data-suite.github.io/pds-portia/schemas/v2/work-relationship.schema.json",
  "title": "Portia Work Relationship v2",
  "description": "Canonical source-owned directional relationship between exact Portia work representations. Version 2 preserves draws_context_from semantics while requiring exact source and target versions and exact cross-work predecessor lineage for correction, migration, and ownership movement.",
  "$comment": "Application validation remains responsible for storage/source identity agreement, endpoint resolution and lifecycle eligibility, self-reference and duplicate-edge checks, lifecycle legality, exact supersession reconciliation, ownership-correction and migration boundaries, no silent endpoint retargeting, and atomic or recoverable successor activation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "module_id",
    "class_id",
    "work_id",
    "relationship_id",
    "status",
    "relationship_type",
    "source",
    "target",
    "creation_source",
    "created_at",
    "created_by",
    "updated_at",
    "updated_by"
  ],
  "properties": {
    "schema_version": {
      "const": "2"
    },
    "record_type": {
      "const": "work_relationship"
    },
    "module_id": {
      "const": "portia"
    },
    "class_id": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/structurally-safe-external-id.schema.json"
    },
    "work_id": {
      "oneOf": [
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-event-id.schema.json"
        },
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-support-process-id.schema.json"
        }
      ]
    },
    "relationship_id": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-work-relationship-id.schema.json"
    },
    "status": {
      "enum": [
        "proposed",
        "active",
        "invalidated",
        "superseded"
      ]
    },
    "relationship_type": {
      "const": "draws_context_from"
    },
    "source": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-portia-work-ref.schema.json"
    },
    "target": {
      "allOf": [
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-portia-work-ref.schema.json"
        },
        {
          "properties": {
            "work_kind": {
              "const": "event"
            }
          },
          "required": [
            "work_kind"
          ]
        }
      ]
    },
    "detail": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/non-empty-text.schema.json"
    },
    "supersedes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/supersessionEntry"
      }
    },
    "creation_source": {
      "allOf": [
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/provenance/creation-source.schema.json"
        },
        {
          "not": {
            "properties": {
              "type": {
                "const": "paper_capture"
              },
              "stage": {
                "const": "preallocated"
              }
            },
            "required": [
              "type",
              "stage"
            ]
          }
        }
      ]
    },
    "created_at": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/explicit-offset-timestamp.schema.json"
    },
    "created_by": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/attribution/attribution-agent.schema.json"
    },
    "updated_at": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/explicit-offset-timestamp.schema.json"
    },
    "updated_by": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/attribution/attribution-agent.schema.json"
    }
  },
  "$defs": {
    "relationshipWorkRecordRef": {
      "allOf": [
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-portia-work-record-ref.schema.json"
        },
        {
          "properties": {
            "record_ref": {
              "allOf": [
                {
                  "properties": {
                    "record_kind": {
                      "const": "work_relationship"
                    },
                    "record_id": {
                      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-work-relationship-id.schema.json"
                    },
                    "contract_version": {
                      "enum": [
                        "1",
                        "2"
                      ]
                    }
                  }
                },
                {
                  "required": [
                    "record_kind",
                    "record_id",
                    "contract_version"
                  ]
                }
              ]
            }
          },
          "required": [
            "work_ref",
            "record_ref"
          ]
        }
      ]
    },
    "supersessionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_record_ref",
        "reason"
      ],
      "properties": {
        "work_record_ref": {
          "$ref": "#/$defs/relationshipWorkRecordRef"
        },
        "reason": {
          "enum": [
            "source_corrected",
            "target_corrected",
            "relationship_type_corrected",
            "material_detail_corrected",
            "duplicate_consolidated",
            "work_root_corrected",
            "contract_migrated",
            "other"
          ]
        },
        "detail": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/non-empty-text.schema.json"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reason": {
                "const": "other"
              }
            },
            "required": [
              "reason"
            ]
          },
          "then": {
            "required": [
              "detail"
            ]
          }
        }
      ]
    }
  },
  "x-portia-application-invariants": [
    "portia.relationship_v2.canonical_storage_scope",
    "portia.relationship_v2.source_envelope_agreement",
    "portia.relationship_v2.endpoint_resolution",
    "portia.relationship_v2.endpoint_lifecycle_eligibility",
    "portia.relationship_v2.self_reference",
    "portia.relationship_v2.active_edge_uniqueness",
    "portia.relationship_v2.inverse_duplicate",
    "portia.relationship_v2.timestamp_chronology",
    "portia.relationship_v2.lifecycle_matrix",
    "portia.relationship_v2.self_supersession",
    "portia.relationship_v2.duplicate_predecessor",
    "portia.relationship_v2.supersession_cycle",
    "portia.relationship_v2.same_family_predecessor",
    "portia.relationship_v2.cross_work_requires_ownership_reason",
    "portia.relationship_v2.ownership_reason_requires_cross_work",
    "portia.relationship_v2.ownership_reconciliation",
    "portia.relationship_v2.migration_identity_preservation",
    "portia.relationship_v2.migration_same_work",
    "portia.relationship_v2.migration_reconciliation",
    "portia.relationship_v2.no_silent_retarget"
  ]
}
