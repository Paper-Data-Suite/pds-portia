{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-data-suite.github.io/pds-portia/schemas/v1/accounts/account.schema.json",
  "title": "Portia Account",
  "description": "Canonical version-1 Portia Account record preserving one coherent attributed statement, report, response, recollection, or perspective from one represented human source concerning one target inside the containing Event. An Account preserves source evidence; it does not establish credibility, truth, a finding, Classification, Hypothesis, Determination, policy violation, severity, diagnosis, intent, behavioral function, guilt, or risk.",
  "$comment": "Application validation remains responsible for canonical path and Event ownership, target resolution, source resolution and current-use eligibility, source/recorder distinction, paper/import review history, evidence-time chronology, source-lineage semantics, source-evidenced retraction, lifecycle legality, supersession topology, incoming-reference reconciliation, reported_involved Role eligibility and target alignment, no silent successor following, authorization, privacy, and recoverable coordinated writes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "module_id",
    "class_id",
    "work_id",
    "account_id",
    "status",
    "target",
    "source",
    "information_origin",
    "source_certainty",
    "content",
    "provided_time",
    "creation_source",
    "created_at",
    "created_by",
    "updated_at",
    "updated_by"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "record_type": {
      "const": "account"
    },
    "module_id": {
      "const": "portia"
    },
    "class_id": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/structurally-safe-external-id.schema.json"
    },
    "work_id": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-event-id.schema.json"
    },
    "account_id": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-account-id.schema.json"
    },
    "status": {
      "enum": [
        "proposed",
        "active",
        "retracted",
        "invalidated",
        "superseded"
      ]
    },
    "target": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/targets/portia-target-ref.schema.json"
    },
    "source": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/attribution/represented-human-attribution.schema.json"
    },
    "information_origin": {
      "enum": [
        "firsthand",
        "secondhand",
        "mixed",
        "unknown"
      ]
    },
    "source_certainty": {
      "enum": [
        "stated_certain",
        "stated_uncertain",
        "mixed_or_qualified",
        "not_recorded"
      ]
    },
    "content": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/contentSegment"
      }
    },
    "elicitation_context": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/non-empty-text.schema.json",
      "description": "Optional recorder-supplied prompt or bounded context needed to understand the source response. It is not source wording."
    },
    "provided_time": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/evidence-time.schema.json"
    },
    "related_accounts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/accountRelation"
      }
    },
    "source_artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/provenance/source-artifact-ref.schema.json"
      }
    },
    "supersedes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/supersessionEntry"
      }
    },
    "creation_source": {
      "allOf": [
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/provenance/creation-source.schema.json"
        },
        {
          "not": {
            "type": "object",
            "properties": {
              "type": {
                "const": "paper_capture"
              },
              "stage": {
                "const": "preallocated"
              }
            },
            "required": [
              "type",
              "stage"
            ]
          }
        }
      ]
    },
    "created_at": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/explicit-offset-timestamp.schema.json"
    },
    "created_by": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/attribution/attribution-agent.schema.json"
    },
    "updated_at": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/explicit-offset-timestamp.schema.json"
    },
    "updated_by": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/attribution/attribution-agent.schema.json"
    }
  },
  "$defs": {
    "contentSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "representation",
        "text"
      ],
      "properties": {
        "representation": {
          "enum": [
            "verbatim_quote",
            "recorded_summary"
          ]
        },
        "text": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/non-empty-text.schema.json"
        }
      }
    },
    "exactAccountRef": {
      "allOf": [
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-local-record-ref.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "record_kind": {
              "const": "account"
            },
            "record_id": {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-account-id.schema.json"
            },
            "contract_version": {
              "const": "1"
            }
          },
          "required": [
            "record_kind",
            "record_id",
            "contract_version"
          ]
        }
      ]
    },
    "accountRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation",
        "account_ref"
      ],
      "properties": {
        "relation": {
          "enum": [
            "reports_from",
            "clarifies",
            "retracts"
          ]
        },
        "account_ref": {
          "$ref": "#/$defs/exactAccountRef"
        }
      }
    },
    "accountWorkRecordRef": {
      "allOf": [
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-portia-work-record-ref.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "record_ref": {
              "allOf": [
                {
                  "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-local-record-ref.schema.json"
                },
                {
                  "type": "object",
                  "properties": {
                    "record_kind": {
                      "const": "account"
                    },
                    "record_id": {
                      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-account-id.schema.json"
                    },
                    "contract_version": {
                      "const": "1"
                    }
                  },
                  "required": [
                    "record_kind",
                    "record_id",
                    "contract_version"
                  ]
                }
              ]
            }
          },
          "required": [
            "work_ref",
            "record_ref"
          ]
        }
      ]
    },
    "supersessionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_record_ref",
        "reason"
      ],
      "properties": {
        "work_record_ref": {
          "$ref": "#/$defs/accountWorkRecordRef"
        },
        "reason": {
          "enum": [
            "source_corrected",
            "source_attribution_corrected",
            "target_corrected",
            "statement_corrected",
            "representation_corrected",
            "information_origin_corrected",
            "timing_corrected",
            "provenance_corrected",
            "duplicate_consolidated",
            "work_root_corrected",
            "contract_migrated",
            "other"
          ]
        },
        "detail": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/non-empty-text.schema.json"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reason": {
                "const": "other"
              }
            },
            "required": [
              "reason"
            ]
          },
          "then": {
            "required": [
              "detail"
            ]
          }
        }
      ]
    }
  },
  "x-portia-application-invariants": [
    "portia.account.canonical_storage_scope",
    "portia.account.path_identity_agreement",
    "portia.account.parent_event_resolution",
    "portia.account.target_resolution",
    "portia.account.target_same_event",
    "portia.account.source_resolution",
    "portia.account.source_recorder_distinction",
    "portia.account.timestamp_chronology",
    "portia.account.provided_time_chronology",
    "portia.account.creation_provenance_immutable",
    "portia.account.paper_provenance_agreement",
    "portia.account.paper_activation_requires_review_history",
    "portia.account.import_activation_requires_review_history",
    "portia.account.information_origin_consistency",
    "portia.account.source_lineage_resolution",
    "portia.account.relation_same_event",
    "portia.account.relation_target_identity_unique",
    "portia.account.relation_self_reference",
    "portia.account.clarification_same_source",
    "portia.account.retraction_same_source",
    "portia.account.retraction_requires_active_retraction_account",
    "portia.account.retraction_predecessor_eligibility",
    "portia.account.retraction_lifecycle_coordination",
    "portia.account.lifecycle_matrix",
    "portia.account.lifecycle_history_reconciliation",
    "portia.account.current_use_eligibility",
    "portia.account.amendment_prohibited_v1",
    "portia.account.predecessor_resolution",
    "portia.account.predecessor_identity_unique",
    "portia.account.self_supersession",
    "portia.account.supersession_reason_uniform",
    "portia.account.replacement_topology",
    "portia.account.supersession_cycle",
    "portia.account.ownership_reconciliation",
    "portia.account.successor_effectiveness",
    "portia.account.incoming_reference_complete",
    "portia.account.no_silent_successor_following",
    "portia.account.reported_involved_source_eligibility",
    "portia.account.reported_involved_target_alignment",
    "portia.account.source_artifact_resolution",
    "portia.account.external_reference_inert",
    "portia.account.no_automatic_finding"
  ]
}
