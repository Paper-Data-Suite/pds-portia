{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-data-suite.github.io/pds-portia/schemas/v1/reentries/reentry.schema.json",
  "title": "Portia Reentry",
  "description": "Canonical version-1 Portia work-local Reentry representing one bounded teacher-local plan/process for supporting return to an ordinary educational setting, activity, relationship context, or classroom workflow after a represented interruption, removal, absence, conflict, or other relevant context. Reentry is not medical or threat-assessment clearance, special-education placement authority, legal permission to attend, punishment, an apology requirement, behavior contract, readiness score, or proof that a prior exclusion was justified.",
  "$comment": "Application validation remains responsible for canonical storage; work/target/coordinator resolution; current-use coordinator eligibility; initiating-context and support-plan exact resolution; same-class agreement; Support Process plan ownership; timing chronology; paper/import review gates; lifecycle/history reconciliation; successor topology; authorization/privacy; and coordinated writes. Completion must not manufacture safety, compliance, rehabilitation, restored relationships, or access authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "module_id",
    "class_id",
    "work_kind",
    "work_id",
    "reentry_id",
    "status",
    "target",
    "coordinator",
    "initiating_context",
    "planned_return",
    "planned_elements",
    "workflow_state",
    "creation_source",
    "created_at",
    "created_by",
    "updated_at",
    "updated_by"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "record_type": {
      "const": "reentry"
    },
    "module_id": {
      "const": "portia"
    },
    "class_id": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/structurally-safe-external-id.schema.json"
    },
    "work_kind": {
      "enum": [
        "event",
        "support_process"
      ]
    },
    "work_id": {
      "type": "string"
    },
    "reentry_id": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-reentry-id.schema.json"
    },
    "status": {
      "enum": [
        "proposed",
        "active",
        "invalidated",
        "superseded"
      ]
    },
    "target": {
      "oneOf": [
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/targets/portia-target-ref.schema.json"
        },
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/targets/support-process-target-ref.schema.json"
        }
      ]
    },
    "coordinator": {
      "$ref": "#/$defs/coordinator"
    },
    "initiating_context": {
      "$ref": "#/$defs/initiatingContext"
    },
    "planned_return": {
      "$ref": "#/$defs/plannedReturn"
    },
    "planned_elements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/plannedElement"
      }
    },
    "support_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/supportPlanRef"
      },
      "description": "Optional exact Support/Intervention links; no plan content is cloned and no effectiveness is implied."
    },
    "workflow_state": {
      "enum": [
        "planned",
        "active",
        "completed",
        "cancelled",
        "unable_to_complete"
      ]
    },
    "completed_at": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/explicit-offset-timestamp.schema.json",
      "description": "Actual process completion time; completion is not clearance, safety, compliance, rehabilitation, or relationship restoration."
    },
    "supersedes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/supersessionEntry"
      }
    },
    "creation_source": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/provenance/creation-source.schema.json"
    },
    "created_at": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/explicit-offset-timestamp.schema.json"
    },
    "created_by": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/attribution/attribution-agent.schema.json"
    },
    "updated_at": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/explicit-offset-timestamp.schema.json"
    },
    "updated_by": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/attribution/attribution-agent.schema.json"
    }
  },
  "$defs": {
    "exactSupportParticipantRef": {
      "allOf": [
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-local-record-ref.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "record_kind": {
              "const": "support_process_participant"
            },
            "record_id": {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-support-process-participant-id.schema.json"
            },
            "contract_version": {
              "const": "1"
            }
          },
          "required": [
            "record_kind",
            "record_id",
            "contract_version"
          ]
        }
      ]
    },
    "eventCoordinator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "person"
      ],
      "properties": {
        "kind": {
          "const": "represented_human"
        },
        "person": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/attribution/represented-human-attribution.schema.json"
        }
      },
      "description": "Event-owned operational Reentry coordinator representation. Application validation checks current-use eligibility; identity does not establish clearance or institutional authority."
    },
    "supportCoordinator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "participant_ref"
      ],
      "properties": {
        "kind": {
          "const": "support_process_participant"
        },
        "participant_ref": {
          "$ref": "#/$defs/exactSupportParticipantRef"
        }
      },
      "description": "Support-Process-owned coordinator. Application validation requires an active exact participant with provider_or_collaborator or coordinator context."
    },
    "coordinator": {
      "oneOf": [
        {
          "$ref": "#/$defs/eventCoordinator"
        },
        {
          "$ref": "#/$defs/supportCoordinator"
        }
      ]
    },
    "exactEventWorkRef": {
      "allOf": [
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-portia-work-ref.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "work_kind": {
              "const": "event"
            },
            "work_id": {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-event-id.schema.json"
            },
            "contract_version": {
              "const": "2"
            }
          },
          "required": [
            "work_kind",
            "work_id",
            "contract_version"
          ]
        }
      ]
    },
    "exactSupportProcessWorkRef": {
      "allOf": [
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-portia-work-ref.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "work_kind": {
              "const": "support_process"
            },
            "work_id": {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-support-process-id.schema.json"
            },
            "contract_version": {
              "const": "1"
            }
          },
          "required": [
            "work_kind",
            "work_id",
            "contract_version"
          ]
        }
      ]
    },
    "determinationRef": {
      "allOf": [
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-portia-work-record-ref.schema.json"
        },
        {
          "type": "object",
          "required": [
            "work_ref",
            "record_ref"
          ],
          "properties": {
            "work_ref": {
              "$ref": "#/$defs/exactEventWorkRef"
            },
            "record_ref": {
              "allOf": [
                {
                  "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-local-record-ref.schema.json"
                },
                {
                  "type": "object",
                  "properties": {
                    "record_kind": {
                      "const": "determination"
                    },
                    "record_id": {
                      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-determination-id.schema.json"
                    },
                    "contract_version": {
                      "const": "1"
                    }
                  },
                  "required": [
                    "record_kind",
                    "record_id",
                    "contract_version"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "responseRef": {
      "allOf": [
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-portia-work-record-ref.schema.json"
        },
        {
          "type": "object",
          "required": [
            "work_ref",
            "record_ref"
          ],
          "properties": {
            "work_ref": {
              "$ref": "#/$defs/exactEventWorkRef"
            },
            "record_ref": {
              "allOf": [
                {
                  "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-local-record-ref.schema.json"
                },
                {
                  "type": "object",
                  "properties": {
                    "record_kind": {
                      "const": "response"
                    },
                    "record_id": {
                      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-response-id.schema.json"
                    },
                    "contract_version": {
                      "const": "1"
                    }
                  },
                  "required": [
                    "record_kind",
                    "record_id",
                    "contract_version"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "communicationRef": {
      "allOf": [
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-portia-work-record-ref.schema.json"
        },
        {
          "type": "object",
          "required": [
            "work_ref",
            "record_ref"
          ],
          "properties": {
            "record_ref": {
              "allOf": [
                {
                  "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-local-record-ref.schema.json"
                },
                {
                  "type": "object",
                  "properties": {
                    "record_kind": {
                      "const": "communication"
                    },
                    "record_id": {
                      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-communication-id.schema.json"
                    },
                    "contract_version": {
                      "const": "1"
                    }
                  },
                  "required": [
                    "record_kind",
                    "record_id",
                    "contract_version"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "eventContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "work_ref"
      ],
      "properties": {
        "kind": {
          "const": "event"
        },
        "work_ref": {
          "$ref": "#/$defs/exactEventWorkRef"
        }
      }
    },
    "determinationContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "record_ref"
      ],
      "properties": {
        "kind": {
          "const": "determination"
        },
        "record_ref": {
          "$ref": "#/$defs/determinationRef"
        }
      }
    },
    "responseContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "record_ref"
      ],
      "properties": {
        "kind": {
          "const": "response"
        },
        "record_ref": {
          "$ref": "#/$defs/responseRef"
        }
      }
    },
    "supportProcessContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "work_ref"
      ],
      "properties": {
        "kind": {
          "const": "support_process"
        },
        "work_ref": {
          "$ref": "#/$defs/exactSupportProcessWorkRef"
        }
      }
    },
    "communicationContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "record_ref"
      ],
      "properties": {
        "kind": {
          "const": "communication"
        },
        "record_ref": {
          "$ref": "#/$defs/communicationRef"
        }
      }
    },
    "externalContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "system_label",
        "reference_id"
      ],
      "properties": {
        "kind": {
          "const": "external_or_restricted_process"
        },
        "system_label": {
          "allOf": [
            {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/non-empty-text.schema.json"
            },
            {
              "maxLength": 200
            }
          ]
        },
        "reference_id": {
          "allOf": [
            {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/non-empty-text.schema.json"
            },
            {
              "maxLength": 500
            }
          ]
        },
        "status_label": {
          "allOf": [
            {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/non-empty-text.schema.json"
            },
            {
              "maxLength": 200
            }
          ]
        }
      },
      "description": "Minimal inert external/restricted-process locator; unrestricted external payload is prohibited."
    },
    "otherContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "detail"
      ],
      "properties": {
        "kind": {
          "const": "other"
        },
        "detail": {
          "allOf": [
            {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/non-empty-text.schema.json"
            },
            {
              "maxLength": 2000
            }
          ]
        }
      }
    },
    "initiatingContext": {
      "oneOf": [
        {
          "$ref": "#/$defs/eventContext"
        },
        {
          "$ref": "#/$defs/determinationContext"
        },
        {
          "$ref": "#/$defs/responseContext"
        },
        {
          "$ref": "#/$defs/supportProcessContext"
        },
        {
          "$ref": "#/$defs/communicationContext"
        },
        {
          "$ref": "#/$defs/externalContext"
        },
        {
          "$ref": "#/$defs/otherContext"
        }
      ]
    },
    "dateOnlyReturn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "date"
      ],
      "properties": {
        "kind": {
          "const": "date_only"
        },
        "date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "exactTimeReturn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "at"
      ],
      "properties": {
        "kind": {
          "const": "exact_time"
        },
        "at": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/explicit-offset-timestamp.schema.json"
        }
      }
    },
    "dateWindowReturn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "starts_on",
        "ends_on"
      ],
      "properties": {
        "kind": {
          "const": "window"
        },
        "starts_on": {
          "type": "string",
          "format": "date"
        },
        "ends_on": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "exactWindowReturn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "starts_at",
        "ends_at"
      ],
      "properties": {
        "kind": {
          "const": "window"
        },
        "starts_at": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/explicit-offset-timestamp.schema.json"
        },
        "ends_at": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/explicit-offset-timestamp.schema.json"
        }
      }
    },
    "plannedReturn": {
      "oneOf": [
        {
          "$ref": "#/$defs/dateOnlyReturn"
        },
        {
          "$ref": "#/$defs/exactTimeReturn"
        },
        {
          "$ref": "#/$defs/dateWindowReturn"
        },
        {
          "$ref": "#/$defs/exactWindowReturn"
        }
      ],
      "description": "Planning-only return timing; elapsed time does not complete Reentry automatically."
    },
    "plannedElement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "description"
      ],
      "properties": {
        "kind": {
          "enum": [
            "orientation_or_check_in",
            "schedule_or_environment",
            "academic_access",
            "support_handoff",
            "relationship_reconnection",
            "communication",
            "other"
          ]
        },
        "description": {
          "allOf": [
            {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/non-empty-text.schema.json"
            },
            {
              "maxLength": 3000
            }
          ]
        }
      },
      "description": "Bounded planned Reentry element only; actual actions remain separate Response, Communication, Implementation, Follow-Up, or Repair records."
    },
    "supportPlanRef": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-portia-work-record-ref.schema.json"
            },
            {
              "type": "object",
              "required": [
                "work_ref",
                "record_ref"
              ],
              "properties": {
                "work_ref": {
                  "$ref": "#/$defs/exactSupportProcessWorkRef"
                },
                "record_ref": {
                  "allOf": [
                    {
                      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-local-record-ref.schema.json"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "record_kind": {
                          "const": "support"
                        },
                        "record_id": {
                          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-support-id.schema.json"
                        },
                        "contract_version": {
                          "const": "1"
                        }
                      },
                      "required": [
                        "record_kind",
                        "record_id",
                        "contract_version"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-portia-work-record-ref.schema.json"
            },
            {
              "type": "object",
              "required": [
                "work_ref",
                "record_ref"
              ],
              "properties": {
                "work_ref": {
                  "$ref": "#/$defs/exactSupportProcessWorkRef"
                },
                "record_ref": {
                  "allOf": [
                    {
                      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-local-record-ref.schema.json"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "record_kind": {
                          "const": "intervention"
                        },
                        "record_id": {
                          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-intervention-id.schema.json"
                        },
                        "contract_version": {
                          "const": "1"
                        }
                      },
                      "required": [
                        "record_kind",
                        "record_id",
                        "contract_version"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
      ]
    },
    "reentryRef": {
      "allOf": [
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-portia-work-record-ref.schema.json"
        },
        {
          "type": "object",
          "required": [
            "work_ref",
            "record_ref"
          ],
          "properties": {
            "record_ref": {
              "allOf": [
                {
                  "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-local-record-ref.schema.json"
                },
                {
                  "type": "object",
                  "properties": {
                    "record_kind": {
                      "const": "reentry"
                    },
                    "record_id": {
                      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-reentry-id.schema.json"
                    },
                    "contract_version": {
                      "const": "1"
                    }
                  },
                  "required": [
                    "record_kind",
                    "record_id",
                    "contract_version"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "supersessionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_record_ref",
        "reason"
      ],
      "properties": {
        "work_record_ref": {
          "$ref": "#/$defs/reentryRef"
        },
        "reason": {
          "enum": [
            "coordinator_corrected",
            "target_corrected",
            "context_corrected",
            "timing_corrected",
            "plan_element_corrected",
            "completion_corrected",
            "duplicate_consolidated",
            "work_root_corrected",
            "contract_migrated",
            "other"
          ]
        },
        "detail": {
          "allOf": [
            {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/non-empty-text.schema.json"
            },
            {
              "maxLength": 2000
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reason": {
                "const": "other"
              }
            },
            "required": [
              "reason"
            ]
          },
          "then": {
            "required": [
              "detail"
            ]
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "work_kind": {
            "const": "event"
          }
        },
        "required": [
          "work_kind"
        ]
      },
      "then": {
        "properties": {
          "work_id": {
