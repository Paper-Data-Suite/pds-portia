{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-data-suite.github.io/pds-portia/schemas/v1/work-relationship.schema.json",
  "title": "Portia Work Relationship",
  "description": "Canonical source-owned directional relationship between Portia works. The initial vocabulary contains only draws_context_from, whose target is always an Event. Reverse navigation is derived and is not stored as another canonical relationship.",
  "$comment": "Application validation remains responsible for canonical storage scope agreement, top-level/source identity agreement, exact endpoint resolution, endpoint lifecycle and use eligibility, self-reference, active edge uniqueness, inverse duplicates, timestamp chronology, lifecycle transitions, supersession cycles, predecessor identity uniqueness, and atomic or recoverable successor activation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "module_id",
    "class_id",
    "work_id",
    "relationship_id",
    "status",
    "relationship_type",
    "source",
    "target",
    "creation_source",
    "created_at",
    "created_by",
    "updated_at",
    "updated_by"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "record_type": {
      "const": "work_relationship"
    },
    "module_id": {
      "const": "portia"
    },
    "class_id": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/structurally-safe-external-id.schema.json"
    },
    "work_id": {
      "oneOf": [
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-event-id.schema.json"
        },
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-support-process-id.schema.json"
        }
      ]
    },
    "relationship_id": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-work-relationship-id.schema.json"
    },
    "status": {
      "enum": [
        "proposed",
        "active",
        "invalidated",
        "superseded"
      ]
    },
    "relationship_type": {
      "const": "draws_context_from"
    },
    "source": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/portia-work-ref.schema.json"
    },
    "target": {
      "allOf": [
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/portia-work-ref.schema.json"
        },
        {
          "properties": {
            "work_kind": {
              "const": "event"
            }
          }
        }
      ]
    },
    "detail": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/non-empty-text.schema.json"
    },
    "supersedes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/supersessionEntry"
      }
    },
    "creation_source": {
      "allOf": [
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/provenance/creation-source.schema.json"
        },
        {
          "not": {
            "properties": {
              "type": {
                "const": "paper_capture"
              },
              "stage": {
                "const": "preallocated"
              }
            },
            "required": [
              "type",
              "stage"
            ]
          }
        }
      ]
    },
    "created_at": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/explicit-offset-timestamp.schema.json"
    },
    "created_by": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/attribution/attribution-agent.schema.json"
    },
    "updated_at": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/explicit-offset-timestamp.schema.json"
    },
    "updated_by": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/attribution/attribution-agent.schema.json"
    }
  },
  "$defs": {
    "relationshipWorkRecordRef": {
      "allOf": [
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/portia-work-record-ref.schema.json"
        },
        {
          "properties": {
            "record_ref": {
              "properties": {
                "record_kind": {
                  "const": "work_relationship"
                },
                "record_id": {
                  "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-work-relationship-id.schema.json"
                },
                "contract_version": {
                  "const": "1"
                }
              },
              "required": [
                "record_kind",
                "record_id",
                "contract_version"
              ]
            }
          }
        }
      ]
    },
    "supersessionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_record_ref",
        "reason"
      ],
      "properties": {
        "work_record_ref": {
          "$ref": "#/$defs/relationshipWorkRecordRef"
        },
        "reason": {
          "enum": [
            "source_corrected",
            "target_corrected",
            "relationship_type_corrected",
            "material_detail_corrected",
            "duplicate_consolidated",
            "other"
          ]
        },
        "detail": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/non-empty-text.schema.json"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reason": {
                "not": {
                  "const": "other"
                }
              }
            },
            "required": [
              "reason"
            ]
          },
          "then": {
            "not": {
              "required": [
                "detail"
              ]
            }
          }
        }
      ]
    }
  }
}
