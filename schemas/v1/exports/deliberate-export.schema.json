{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-data-suite.github.io/pds-portia/schemas/v1/exports/deliberate-export.schema.json",
  "title": "Portia Deliberate Export",
  "description": "Immutable operational provenance record for one deliberately requested, privacy-projected Portia output artifact after the artifact has been durably written and read-back verified. The record binds exact purpose, scope, policy, authorization reference, contributing source representations, privacy-decision digest, manual-review state, output bytes, and coordinated-operation evidence. It is not a disclosure, delivery, receipt, consent record, legal authorization decision, student dossier, or behavior-domain fact.",
  "$comment": "Application validation must require deliberate human request attribution, exact scope and focal-subject rules, supported policy identity, positive authorization for the exact export, source-inventory verification, projection-decision digest verification, resolved-or-not-required manual review, output-path/export-id agreement, output digest/length read-back, exclusive artifact and record creation, exact operation-journal reconciliation, chronology, supersession topology, and no implication that generation equals disclosure.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "module_id",
    "export_id",
    "projection_purpose",
    "export_scope",
    "projection_policy",
    "authorization",
    "source_inventory",
    "projection_decision_digest",
    "disposition_summary",
    "manual_review",
    "output",
    "operation_journal_ref",
    "requested_at",
    "requested_by",
    "generated_at",
    "generated_by"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "record_type": {
      "const": "deliberate_export"
    },
    "module_id": {
      "const": "portia"
    },
    "export_id": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-deliberate-export-id.schema.json"
    },
    "projection_purpose": {
      "enum": [
        "teacher_current",
        "participant_specific",
        "student_facing",
        "family_facing",
        "aggregate_equity",
        "administrative_export"
      ]
    },
    "export_scope": {
      "$ref": "#/$defs/exportScope"
    },
    "focal_subject_ref": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-portia-work-record-ref.schema.json"
    },
    "projection_policy": {
      "$ref": "#/$defs/projectionPolicy"
    },
    "authorization": {
      "$ref": "#/$defs/authorization"
    },
    "source_inventory": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/exports/export-source-inventory.schema.json"
    },
    "projection_decision_digest": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/sha256-digest.schema.json"
    },
    "disposition_summary": {
      "$ref": "#/$defs/dispositionSummary"
    },
    "manual_review": {
      "$ref": "#/$defs/manualReview"
    },
    "output": {
      "$ref": "#/$defs/output"
    },
    "operation_journal_ref": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/operation-journal-ref.schema.json"
    },
    "requested_at": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/explicit-offset-timestamp.schema.json"
    },
    "requested_by": {
      "$ref": "#/$defs/localOperator"
    },
    "generated_at": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/explicit-offset-timestamp.schema.json"
    },
    "generated_by": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/attribution/attribution-agent.schema.json"
    },
    "supersedes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/supersessionEntry"
      }
    }
  },
  "$defs": {
    "localOperator": {
      "allOf": [
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/attribution/attribution-agent.schema.json"
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "local_operator"
            }
          }
        }
      ]
    },
    "exportScope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "work_ref"
          ],
          "properties": {
            "scope": {
              "const": "work"
            },
            "work_ref": {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-portia-work-ref.schema.json"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "class_id"
          ],
          "properties": {
            "scope": {
              "const": "class"
            },
            "class_id": {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/structurally-safe-external-id.schema.json"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "workspace_id"
          ],
          "properties": {
            "scope": {
              "const": "workspace"
            },
            "workspace_id": {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/structurally-safe-external-id.schema.json"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "scope_id"
          ],
          "properties": {
            "scope": {
              "const": "explicit_source_set"
            },
            "scope_id": {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/structurally-safe-external-id.schema.json"
            }
          }
        }
      ]
    },
    "projectionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_version",
        "policy_digest"
      ],
      "properties": {
        "policy_id": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/structurally-safe-external-id.schema.json"
        },
        "policy_version": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/structurally-safe-external-id.schema.json"
        },
        "policy_digest": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/sha256-digest.schema.json"
        }
      }
    },
    "authorization": {
      "oneOf": [
        {
          "$ref": "#/$defs/policyRuleAuthorization"
        },
        {
          "$ref": "#/$defs/externalDecisionAuthorization"
        }
      ]
    },
    "policyRuleAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "result",
        "authorization_scope_id",
        "policy_rule_id",
        "policy_rule_version",
        "policy_rule_digest",
        "evaluated_at",
        "recorded_by"
      ],
      "properties": {
        "kind": {
          "const": "policy_rule"
        },
        "result": {
          "const": "authorized"
        },
        "authorization_scope_id": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/structurally-safe-external-id.schema.json"
        },
        "policy_rule_id": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/structurally-safe-external-id.schema.json"
        },
        "policy_rule_version": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/structurally-safe-external-id.schema.json"
        },
        "policy_rule_digest": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/sha256-digest.schema.json"
        },
        "evaluated_at": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/explicit-offset-timestamp.schema.json"
        },
        "recorded_by": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/attribution/attribution-agent.schema.json"
        }
      }
    },
    "externalDecisionAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "result",
        "system_label",
        "decision_id",
        "decision_version",
        "decision_digest",
        "evaluated_at",
        "recorded_by"
      ],
      "properties": {
        "kind": {
          "const": "external_decision"
        },
        "result": {
          "const": "authorized"
        },
        "system_label": {
          "allOf": [
            {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/non-empty-text.schema.json"
            },
            {
              "maxLength": 200
            }
          ]
        },
        "decision_id": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/structurally-safe-external-id.schema.json"
        },
        "decision_version": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/structurally-safe-external-id.schema.json"
        },
        "decision_digest": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/sha256-digest.schema.json"
        },
        "evaluated_at": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/explicit-offset-timestamp.schema.json"
        },
        "recorded_by": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/attribution/attribution-agent.schema.json"
        }
      }
    },
    "dispositionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count_unit",
        "included",
        "withheld",
        "unavailable",
        "absent",
        "manual_review_resolved"
      ],
      "properties": {
        "count_unit": {
          "const": "projection_item"
        },
        "included": {
          "type": "integer",
          "minimum": 0
        },
        "withheld": {
          "type": "integer",
          "minimum": 0
        },
        "unavailable": {
          "type": "integer",
          "minimum": 0
        },
        "absent": {
          "type": "integer",
          "minimum": 0
        },
        "manual_review_resolved": {
          "type": "integer",
          "minimum": 0
        }
      },
      "description": "Privacy-minimized counts of projection-item dispositions. Exact withheld or unavailable source identities are intentionally not persisted here."
    },
    "manualReview": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "not_required"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reviewed_projection_digest",
            "reviewed_at",
            "reviewed_by"
          ],
          "properties": {
            "status": {
              "const": "resolved"
            },
            "reviewed_projection_digest": {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/sha256-digest.schema.json"
            },
            "reviewed_at": {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/explicit-offset-timestamp.schema.json"
            },
            "reviewed_by": {
              "$ref": "#/$defs/localOperator"
            }
          }
        }
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "media_type",
        "workspace_relative_path",
        "byte_length",
        "sha256_digest"
      ],
      "properties": {
        "format": {
          "enum": [
            "json",
            "csv",
            "pdf",
            "html",
            "zip",
            "other"
          ]
        },
        "other_format": {
          "allOf": [
            {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/non-empty-text.schema.json"
            },
            {
              "maxLength": 100
            }
          ]
        },
        "media_type": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$"
        },
        "workspace_relative_path": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/workspace-relative-path.schema.json"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        },
        "sha256_digest": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/sha256-digest.schema.json"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "format": {
                "const": "other"
              }
            },
            "required": [
              "format"
            ]
          },
          "then": {
            "required": [
              "other_format"
            ]
          },
          "else": {
            "not": {
              "required": [
                "other_format"
              ]
            }
          }
        }
      ]
    },
    "exportRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "export_id",
        "contract_version"
      ],
      "properties": {
        "export_id": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-deliberate-export-id.schema.json"
        },
        "contract_version": {
          "const": "1"
        }
      }
    },
    "supersessionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "export_ref",
        "reason"
      ],
      "properties": {
        "export_ref": {
          "$ref": "#/$defs/exportRef"
        },
        "reason": {
          "enum": [
            "source_corrected",
            "policy_changed",
            "scope_corrected",
            "format_corrected",
            "authorization_changed",
            "duplicate_replaced",
            "other"
          ]
        },
        "detail": {
          "allOf": [
            {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/non-empty-text.schema.json"
            },
            {
              "maxLength": 500
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reason": {
                "const": "other"
              }
            },
            "required": [
              "reason"
            ]
          },
          "then": {
            "required": [
              "detail"
            ]
          }
        }
      ]
    }
  },
  "x-portia-application-invariants": [
    "portia.deliberate_export.canonical_storage_scope",
    "portia.deliberate_export.path_identity_agreement",
    "portia.deliberate_export.deliberate_local_operator_request",
    "portia.deliberate_export.scope_resolves_exactly",
    "portia.deliberate_export.focal_subject_required_for_focal_purposes",
    "portia.deliberate_export.focal_subject_scope_alignment",
    "portia.deliberate_export.projection_policy_supported",
    "portia.deliberate_export.authorization_positive_for_exact_scope_and_purpose",
    "portia.deliberate_export.authorization_is_provenance_not_legal_conclusion",
    "portia.deliberate_export.source_inventory_verified",
    "portia.deliberate_export.projection_decision_digest_verified",
    "portia.deliberate_export.manual_review_resolved_or_not_required",
    "portia.deliberate_export.manual_review_digest_agreement",
    "portia.deliberate_export.disposition_summary_reconciles_projection",
    "portia.deliberate_export.output_path_is_privacy_safe_and_export_scoped",
    "portia.deliberate_export.output_digest_and_length_readback",
    "portia.deliberate_export.output_bytes_outside_canonical_json",
    "portia.deliberate_export.operation_journal_exact_and_committed",
    "portia.deliberate_export.request_generation_chronology",
    "portia.deliberate_export.exclusive_creation",
    "portia.deliberate_export.self_supersession",
    "portia.deliberate_export.duplicate_predecessor",
    "portia.deliberate_export.supersession_cycle",
    "portia.deliberate_export.historical_export_immutable",
    "portia.deliberate_export.generation_not_disclosure",
    "portia.deliberate_export.no_raw_private_record_passthrough"
  ]
}
