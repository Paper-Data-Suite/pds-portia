{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-data-suite.github.io/pds-portia/schemas/v1/operations/operation-lock.schema.json",
  "title": "Portia Operation Lock",
  "description": "Exclusive privacy-minimized lock record for one deterministic Portia lock key. The stable lock identifier is the lowercase SHA-256 digest of the canonical lock-scope and protected-target encoding. The record does not prove process liveness, authorize mutation, or permit age-based clearing.",
  "$comment": "Application validation must recompute the lock ID from the accepted canonical lock-key algorithm, establish scope/target agreement, verify owning-operation identity and journal state, acquire by exclusive creation, preserve the exact file fingerprint externally, detect conflicting ancestor and descendant locks, and require external no-active-writer evidence before exact fingerprint-protected clearing. Lock age or filesystem modification time is never sufficient.",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "module_id",
    "lock_id",
    "lock_scope",
    "protected_target",
    "owning_operation",
    "acquired_at",
    "deployment_instance_id",
    "process_instance_id"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "record_type": {
      "const": "operation_lock"
    },
    "module_id": {
      "const": "portia"
    },
    "lock_id": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-lock-id.schema.json"
    },
    "lock_scope": {
      "enum": [
        "operation",
        "workspace",
        "class",
        "work",
        "record",
        "derived_projection"
      ]
    },
    "protected_target": {
      "$ref": "#/$defs/lockTarget"
    },
    "owning_operation": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/operation-ref.schema.json"
    },
    "acquired_at": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/explicit-offset-timestamp.schema.json"
    },
    "deployment_instance_id": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/structurally-safe-external-id.schema.json"
    },
    "process_instance_id": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/structurally-safe-external-id.schema.json"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lock_scope": {
            "const": "operation"
          }
        },
        "required": [
          "lock_scope"
        ]
      },
      "then": {
        "properties": {
          "protected_target": {
            "$ref": "#/$defs/operationLockTarget"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lock_scope": {
            "const": "workspace"
          }
        },
        "required": [
          "lock_scope"
        ]
      },
      "then": {
        "properties": {
          "protected_target": {
            "$ref": "#/$defs/workspaceLockTarget"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lock_scope": {
            "const": "class"
          }
        },
        "required": [
          "lock_scope"
        ]
      },
      "then": {
        "properties": {
          "protected_target": {
            "$ref": "#/$defs/classLockTarget"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lock_scope": {
            "const": "work"
          }
        },
        "required": [
          "lock_scope"
        ]
      },
      "then": {
        "properties": {
          "protected_target": {
            "$ref": "#/$defs/workLockTarget"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lock_scope": {
            "const": "record"
          }
        },
        "required": [
          "lock_scope"
        ]
      },
      "then": {
        "properties": {
          "protected_target": {
            "$ref": "#/$defs/recordLockTarget"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lock_scope": {
            "const": "derived_projection"
          }
        },
        "required": [
          "lock_scope"
        ]
      },
      "then": {
        "properties": {
          "protected_target": {
            "$ref": "#/$defs/derivedProjectionLockTarget"
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "projectionScope": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "scope",
            "work_ref"
          ],
          "properties": {
            "scope": {
              "const": "work"
            },
            "work_ref": {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-portia-work-ref.schema.json"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "scope",
            "class_id"
          ],
          "properties": {
            "scope": {
              "const": "class"
            },
            "class_id": {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/structurally-safe-external-id.schema.json"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "scope"
          ],
          "properties": {
            "scope": {
              "const": "workspace"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "scope",
            "operation_ref"
          ],
          "properties": {
            "scope": {
              "const": "operation"
            },
            "operation_ref": {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/operation-ref.schema.json"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "scope",
            "graph_id"
          ],
          "properties": {
            "scope": {
              "const": "graph"
            },
            "graph_id": {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/structurally-safe-external-id.schema.json"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "operationLockTarget": {
      "type": "object",
      "required": [
        "kind",
        "operation_ref"
      ],
      "properties": {
        "kind": {
          "const": "operation"
        },
        "operation_ref": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/operation-ref.schema.json"
        }
      },
      "additionalProperties": false
    },
    "workspaceLockTarget": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "workspace"
        }
      },
      "additionalProperties": false
    },
    "classLockTarget": {
      "type": "object",
      "required": [
        "kind",
        "class_id"
      ],
      "properties": {
        "kind": {
          "const": "class"
        },
        "class_id": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/structurally-safe-external-id.schema.json"
        }
      },
      "additionalProperties": false
    },
    "workLockTarget": {
      "type": "object",
      "required": [
        "kind",
        "work_ref"
      ],
      "properties": {
        "kind": {
          "const": "work"
        },
        "work_ref": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-portia-work-ref.schema.json"
        }
      },
      "additionalProperties": false
    },
    "recordLockTarget": {
      "type": "object",
      "required": [
        "kind",
        "work_record_ref"
      ],
      "properties": {
        "kind": {
          "const": "record"
        },
        "work_record_ref": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-portia-work-record-ref.schema.json"
        }
      },
      "additionalProperties": false
    },
    "derivedProjectionLockTarget": {
      "type": "object",
      "required": [
        "kind",
        "projection_kind",
        "projection_scope"
      ],
      "properties": {
        "kind": {
          "const": "derived_projection"
        },
        "projection_kind": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/lowercase-token.schema.json"
        },
        "projection_scope": {
          "$ref": "#/$defs/projectionScope"
        }
      },
      "additionalProperties": false
    },
    "lockTarget": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "operation_ref"
          ],
          "properties": {
            "kind": {
              "const": "operation"
            },
            "operation_ref": {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/operation-ref.schema.json"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "workspace"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "class_id"
          ],
          "properties": {
            "kind": {
              "const": "class"
            },
            "class_id": {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/structurally-safe-external-id.schema.json"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "work_ref"
          ],
          "properties": {
            "kind": {
              "const": "work"
            },
            "work_ref": {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-portia-work-ref.schema.json"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "work_record_ref"
          ],
          "properties": {
            "kind": {
              "const": "record"
            },
            "work_record_ref": {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-portia-work-record-ref.schema.json"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "projection_kind",
            "projection_scope"
          ],
          "properties": {
            "kind": {
              "const": "derived_projection"
            },
            "projection_kind": {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/lowercase-token.schema.json"
            },
            "projection_scope": {
              "$ref": "#/$defs/projectionScope"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
