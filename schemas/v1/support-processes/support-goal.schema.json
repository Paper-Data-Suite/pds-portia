{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-data-suite.github.io/pds-portia/schemas/v1/support-processes/support-goal.schema.json",
  "title": "Portia Support Goal",
  "description": "Canonical version-1 Support Process-local Goal representing one intended support objective or desired future condition for one Support Process target. A Goal may describe planned criteria and a planned measurement approach, but does not record current progress, attainment, effectiveness, compliance, academic Grade, standards proficiency, punishment, predicted result, or Outcome.",
  "$comment": "Application validation remains responsible for canonical path/owner agreement; parent Support Process resolution and current-use eligibility; target resolution and same-process participant ownership; logical target uniqueness; paper/import activation gates; lifecycle/history reconciliation; supersession topology; ownership correction; no silent successor following; authorization/privacy; and coordinated writes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "module_id",
    "class_id",
    "work_id",
    "goal_id",
    "status",
    "target",
    "description",
    "creation_source",
    "created_at",
    "created_by",
    "updated_at",
    "updated_by"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "record_type": {
      "const": "support_goal"
    },
    "module_id": {
      "const": "portia"
    },
    "class_id": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/structurally-safe-external-id.schema.json"
    },
    "work_id": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-support-process-id.schema.json"
    },
    "goal_id": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-support-goal-id.schema.json"
    },
    "status": {
      "enum": [
        "proposed",
        "active",
        "invalidated",
        "superseded"
      ]
    },
    "target": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/targets/support-process-target-ref.schema.json"
    },
    "description": {
      "allOf": [
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/non-empty-text.schema.json"
        },
        {
          "maxLength": 4000
        }
      ]
    },
    "planned_criteria": {
      "allOf": [
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/non-empty-text.schema.json"
        },
        {
          "maxLength": 3000
        }
      ],
      "description": "Optional planned criteria for later review. Presence does not assert current progress or attainment."
    },
    "measurement_approach": {
      "allOf": [
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/non-empty-text.schema.json"
        },
        {
          "maxLength": 3000
        }
      ],
      "description": "Optional planned approach for later observation/review. It does not create an Outcome or measurement result."
    },
    "supersedes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/supersessionEntry"
      }
    },
    "creation_source": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/provenance/creation-source.schema.json"
    },
    "created_at": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/explicit-offset-timestamp.schema.json"
    },
    "created_by": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/attribution/attribution-agent.schema.json"
    },
    "updated_at": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/explicit-offset-timestamp.schema.json"
    },
    "updated_by": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/attribution/attribution-agent.schema.json"
    }
  },
  "$defs": {
    "supportGoalWorkRecordRef": {
      "allOf": [
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-portia-work-record-ref.schema.json"
        },
        {
          "type": "object",
          "required": [
            "work_ref",
            "record_ref"
          ],
          "properties": {
            "work_ref": {
              "allOf": [
                {
                  "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-portia-work-ref.schema.json"
                },
                {
                  "type": "object",
                  "properties": {
                    "work_kind": {
                      "const": "support_process"
                    },
                    "work_id": {
                      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-support-process-id.schema.json"
                    },
                    "contract_version": {
                      "const": "1"
                    }
                  },
                  "required": [
                    "work_kind",
                    "work_id",
                    "contract_version"
                  ]
                }
              ]
            },
            "record_ref": {
              "allOf": [
                {
                  "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-local-record-ref.schema.json"
                },
                {
                  "type": "object",
                  "properties": {
                    "record_kind": {
                      "const": "support_goal"
                    },
                    "record_id": {
                      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-support-goal-id.schema.json"
                    },
                    "contract_version": {
                      "const": "1"
                    }
                  },
                  "required": [
                    "record_kind",
                    "record_id",
                    "contract_version"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "supersessionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_record_ref",
        "reason"
      ],
      "properties": {
        "work_record_ref": {
          "$ref": "#/$defs/supportGoalWorkRecordRef"
        },
        "reason": {
          "enum": [
            "target_corrected",
            "description_corrected",
            "criteria_corrected",
            "measurement_approach_corrected",
            "duplicate_consolidated",
            "work_root_corrected",
            "contract_migrated",
            "other"
          ]
        },
        "detail": {
          "allOf": [
            {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/non-empty-text.schema.json"
            },
            {
              "maxLength": 2000
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reason": {
                "const": "other"
              }
            },
            "required": [
              "reason"
            ]
          },
          "then": {
            "required": [
              "detail"
            ]
          }
        }
      ]
    }
  },
  "x-portia-application-invariants": [
    "portia.support_goal.canonical_storage_scope",
    "portia.support_goal.path_identity_agreement",
    "portia.support_goal.parent_support_process_resolution",
    "portia.support_goal.owner_agreement",
    "portia.support_goal.target_resolution",
    "portia.support_goal.target_same_support_process",
    "portia.support_goal.target_logical_identity_unique",
    "portia.support_goal.creation_provenance_immutable",
    "portia.support_goal.paper_activation_requires_review_history",
    "portia.support_goal.import_activation_requires_review_history",
    "portia.support_goal.lifecycle_matrix",
    "portia.support_goal.lifecycle_history_reconciliation",
    "portia.support_goal.predecessor_resolution",
    "portia.support_goal.predecessor_identity_unique",
    "portia.support_goal.self_supersession",
    "portia.support_goal.supersession_reason_uniform",
    "portia.support_goal.replacement_topology",
    "portia.support_goal.ownership_reconciliation",
    "portia.support_goal.no_silent_successor_following",
    "portia.support_goal.amendment_prohibited_v1",
    "portia.support_goal.criteria_are_planning_only",
    "portia.support_goal.measurement_approach_is_planning_only",
    "portia.support_goal.no_progress_or_attainment",
    "portia.support_goal.no_grade_or_proficiency",
    "portia.support_goal.no_outcome_or_effectiveness"
  ]
}
