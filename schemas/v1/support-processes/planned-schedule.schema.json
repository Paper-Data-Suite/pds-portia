{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-data-suite.github.io/pds-portia/schemas/v1/support-processes/planned-schedule.schema.json",
  "title": "Portia Planned Schedule",
  "description": "Closed planning-only cadence/window/duration primitive for a Portia Support or Intervention. It describes what is planned, not what was actually implemented. A calendar or reminder occurrence does not create an Implementation.",
  "oneOf": [
    {
      "$ref": "#/$defs/asNeeded"
    },
    {
      "$ref": "#/$defs/recurring"
    },
    {
      "$ref": "#/$defs/conditionTriggered"
    },
    {
      "$ref": "#/$defs/custom"
    }
  ],
  "$defs": {
    "window": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "starts_on": {
          "type": "string",
          "format": "date"
        },
        "ends_on": {
          "type": "string",
          "format": "date"
        },
        "review_on": {
          "type": "string",
          "format": "date"
        }
      },
      "description": "Optional planning dates. Application validation checks chronology; dates never transition plan or process state automatically."
    },
    "minutesDuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "minutes"
      ],
      "properties": {
        "kind": {
          "const": "minutes"
        },
        "minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10080
        }
      }
    },
    "rangeMinutesDuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "minimum_minutes",
        "maximum_minutes"
      ],
      "properties": {
        "kind": {
          "const": "range_minutes"
        },
        "minimum_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10080
        },
        "maximum_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10080
        }
      },
      "description": "Application validation requires minimum_minutes <= maximum_minutes."
    },
    "plannedDuration": {
      "oneOf": [
        {
          "$ref": "#/$defs/minutesDuration"
        },
        {
          "$ref": "#/$defs/rangeMinutesDuration"
        }
      ]
    },
    "frequency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "occurrences",
        "interval_count",
        "interval_unit"
      ],
      "properties": {
        "occurrences": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "interval_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        },
        "interval_unit": {
          "enum": [
            "day",
            "week",
            "month"
          ]
        }
      },
      "description": "Typed planned recurrence. This is planned cadence, not an authoritative implementation count."
    },
    "selectedDays": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "monday",
          "tuesday",
          "wednesday",
          "thursday",
          "friday",
          "saturday",
          "sunday"
        ]
      }
    },
    "asNeeded": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "as_needed"
        },
        "window": {
          "$ref": "#/$defs/window"
        },
        "planned_duration": {
          "$ref": "#/$defs/plannedDuration"
        }
      },
      "description": "As-needed planning without fabricated frequency. Active Intervention application policy does not permit bare as_needed scheduling."
    },
    "recurring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "frequency"
      ],
      "properties": {
        "kind": {
          "const": "recurring"
        },
        "window": {
          "$ref": "#/$defs/window"
        },
        "planned_duration": {
          "$ref": "#/$defs/plannedDuration"
        },
        "frequency": {
          "$ref": "#/$defs/frequency"
        },
        "selected_days": {
          "$ref": "#/$defs/selectedDays"
        },
        "timing_detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "conditionTriggered": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "trigger"
      ],
      "properties": {
        "kind": {
          "const": "condition_triggered"
        },
        "window": {
          "$ref": "#/$defs/window"
        },
        "planned_duration": {
          "$ref": "#/$defs/plannedDuration"
        },
        "trigger": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "custom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "description"
      ],
      "properties": {
        "kind": {
          "const": "custom"
        },
        "window": {
          "$ref": "#/$defs/window"
        },
        "planned_duration": {
          "$ref": "#/$defs/plannedDuration"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    }
  },
  "x-portia-application-invariants": [
    "portia.planned_schedule.window_chronology",
    "portia.planned_schedule.duration_range_order",
    "portia.planned_schedule.no_implementation_claim"
  ]
}
