{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-data-suite.github.io/pds-portia/schemas/v1/support-processes/fidelity.schema.json",
  "title": "Portia Fidelity",
  "description": "Canonical version-1 Support Process-local Fidelity record representing one attributed evaluation of how closely one exact Implementation, an explicit set of Implementations, or a bounded interval of one exact Support/Intervention matched that exact plan or protocol. Fidelity is implementation-quality evaluation only; it is not effectiveness, Outcome, provider competence, student compliance, diagnosis, authorization, or proof that the plan was appropriate.",
  "$comment": "Application validation remains responsible for parent Support Process resolution; exact plan/evaluator/scope/basis-record resolution; same-process and same-plan scope agreement; interval chronology; instrument scale validation; recording chronology; paper/import review gates; lifecycle/history reconciliation; successor topology; ownership correction; no silent successor following; authorization/privacy; and coordinated writes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "module_id",
    "class_id",
    "work_id",
    "fidelity_id",
    "status",
    "plan_ref",
    "evaluator_ref",
    "scope",
    "result",
    "basis",
    "evaluated_at",
    "creation_source",
    "created_at",
    "created_by",
    "updated_at",
    "updated_by"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "record_type": {
      "const": "fidelity"
    },
    "module_id": {
      "const": "portia"
    },
    "class_id": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/structurally-safe-external-id.schema.json"
    },
    "work_id": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-support-process-id.schema.json"
    },
    "fidelity_id": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-fidelity-id.schema.json"
    },
    "status": {
      "enum": [
        "proposed",
        "active",
        "invalidated",
        "superseded"
      ]
    },
    "plan_ref": {
      "oneOf": [
        {
          "$ref": "#/$defs/exactSupportRef"
        },
        {
          "$ref": "#/$defs/exactInterventionRef"
        }
      ]
    },
    "evaluator_ref": {
      "$ref": "#/$defs/exactParticipantRef"
    },
    "scope": {
      "oneOf": [
        {
          "$ref": "#/$defs/oneImplementationScope"
        },
        {
          "$ref": "#/$defs/implementationSetScope"
        },
        {
          "$ref": "#/$defs/boundedPlanIntervalScope"
        }
      ]
    },
    "result": {
      "enum": [
        "as_planned",
        "partially_as_planned",
        "not_as_planned",
        "unable_to_determine",
        "not_applicable"
      ]
    },
    "basis": {
      "$ref": "#/$defs/basis"
    },
    "instrument_result": {
      "$ref": "#/$defs/instrumentResult"
    },
    "evaluated_at": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/explicit-offset-timestamp.schema.json"
    },
    "summary": {
      "allOf": [
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/non-empty-text.schema.json"
        },
        {
          "maxLength": 4000
        }
      ]
    },
    "supersedes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/supersessionEntry"
      }
    },
    "creation_source": {
      "allOf": [
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/provenance/creation-source.schema.json"
        },
        {
          "not": {
            "type": "object",
            "properties": {
              "type": {
                "const": "paper_capture"
              },
              "stage": {
                "const": "preallocated"
              }
            },
            "required": [
              "type",
              "stage"
            ]
          }
        }
      ]
    },
    "created_at": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/explicit-offset-timestamp.schema.json"
    },
    "created_by": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/attribution/attribution-agent.schema.json"
    },
    "updated_at": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/explicit-offset-timestamp.schema.json"
    },
    "updated_by": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/attribution/attribution-agent.schema.json"
    }
  },
  "$defs": {
    "exactSupportRef": {
      "allOf": [
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-local-record-ref.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "record_kind": {
              "const": "support"
            },
            "record_id": {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-support-id.schema.json"
            },
            "contract_version": {
              "const": "1"
            }
          },
          "required": [
            "record_kind",
            "record_id",
            "contract_version"
          ]
        }
      ]
    },
    "exactInterventionRef": {
      "allOf": [
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-local-record-ref.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "record_kind": {
              "const": "intervention"
            },
            "record_id": {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-intervention-id.schema.json"
            },
            "contract_version": {
              "const": "1"
            }
          },
          "required": [
            "record_kind",
            "record_id",
            "contract_version"
          ]
        }
      ]
    },
    "exactParticipantRef": {
      "allOf": [
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-local-record-ref.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "record_kind": {
              "const": "support_process_participant"
            },
            "record_id": {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-support-process-participant-id.schema.json"
            },
            "contract_version": {
              "const": "1"
            }
          },
          "required": [
            "record_kind",
            "record_id",
            "contract_version"
          ]
        }
      ]
    },
    "exactImplementationRef": {
      "allOf": [
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-local-record-ref.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "record_kind": {
              "const": "implementation"
            },
            "record_id": {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-implementation-id.schema.json"
            },
            "contract_version": {
              "const": "1"
            }
          },
          "required": [
            "record_kind",
            "record_id",
            "contract_version"
          ]
        }
      ]
    },
    "oneImplementationScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "implementation_ref"
      ],
      "properties": {
        "kind": {
          "const": "one_implementation"
        },
        "implementation_ref": {
          "$ref": "#/$defs/exactImplementationRef"
        }
      }
    },
    "implementationSetScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "implementation_refs"
      ],
      "properties": {
        "kind": {
          "const": "implementation_set"
        },
        "implementation_refs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 200,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/exactImplementationRef"
          }
        }
      }
    },
    "boundedPlanIntervalScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "started_at",
        "ended_at"
      ],
      "properties": {
        "kind": {
          "const": "bounded_plan_interval"
        },
        "started_at": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/explicit-offset-timestamp.schema.json"
        },
        "ended_at": {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/explicit-offset-timestamp.schema.json"
        }
      }
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "direct_observation",
            "implementation_records",
            "checklist_or_instrument",
            "record_review",
            "combined",
            "other"
          ]
        },
        "detail": {
          "allOf": [
            {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/non-empty-text.schema.json"
            },
            {
              "maxLength": 4000
            }
          ]
        },
        "record_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "uniqueItems": true,
          "items": {
            "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-local-record-ref.schema.json"
          }
        },
        "instrument_use": {
          "enum": [
            "unscored",
            "scored"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "other"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "detail"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "checklist_or_instrument"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "instrument_use"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "direct_observation",
                  "implementation_records",
                  "record_review",
                  "other"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "required": [
                "instrument_use"
              ]
            }
          }
        }
      ]
    },
    "instrumentResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instrument_name",
        "instrument_version",
        "scale_minimum",
        "scale_maximum",
        "value"
      ],
      "properties": {
        "instrument_name": {
          "allOf": [
            {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/non-empty-text.schema.json"
            },
            {
              "maxLength": 1000
            }
          ]
        },
        "instrument_version": {
          "allOf": [
            {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/non-empty-text.schema.json"
            },
            {
              "maxLength": 1000
            }
          ]
        },
        "scale_minimum": {
          "type": "number"
        },
        "scale_maximum": {
          "type": "number"
        },
        "value": {
          "type": "number"
        },
        "scale_label": {
          "allOf": [
            {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/non-empty-text.schema.json"
            },
            {
              "maxLength": 1000
            }
          ]
        }
      }
    },
    "fidelityWorkRecordRef": {
      "allOf": [
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-portia-work-record-ref.schema.json"
        },
        {
          "type": "object",
          "required": [
            "work_ref",
            "record_ref"
          ],
          "properties": {
            "work_ref": {
              "allOf": [
                {
                  "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-portia-work-ref.schema.json"
                },
                {
                  "type": "object",
                  "properties": {
                    "work_kind": {
                      "const": "support_process"
                    },
                    "work_id": {
                      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-support-process-id.schema.json"
                    },
                    "contract_version": {
                      "const": "1"
                    }
                  },
                  "required": [
                    "work_kind",
                    "work_id",
                    "contract_version"
                  ]
                }
              ]
            },
            "record_ref": {
              "allOf": [
                {
                  "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-local-record-ref.schema.json"
                },
                {
                  "type": "object",
                  "properties": {
                    "record_kind": {
                      "const": "fidelity"
                    },
                    "record_id": {
                      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-fidelity-id.schema.json"
                    },
                    "contract_version": {
                      "const": "1"
                    }
                  },
                  "required": [
                    "record_kind",
                    "record_id",
                    "contract_version"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "supersessionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_record_ref",
        "reason"
      ],
      "properties": {
        "work_record_ref": {
          "$ref": "#/$defs/fidelityWorkRecordRef"
        },
        "reason": {
          "enum": [
            "evaluator_corrected",
            "scope_corrected",
            "basis_corrected",
            "result_corrected",
            "instrument_result_corrected",
            "evaluation_period_corrected",
            "duplicate_consolidated",
            "work_root_corrected",
            "contract_migrated",
            "other"
          ]
        },
        "detail": {
          "allOf": [
            {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/non-empty-text.schema.json"
            },
            {
              "maxLength": 2000
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reason": {
                "const": "other"
              }
            },
            "required": [
              "reason"
            ]
          },
          "then": {
            "required": [
              "detail"
            ]
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "basis": {
            "type": "object",
            "properties": {
              "instrument_use": {
                "const": "scored"
              }
            },
            "required": [
              "instrument_use"
            ]
          }
        },
        "required": [
          "basis"
        ]
      },
      "then": {
        "required": [
          "instrument_result"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "basis": {
            "type": "object",
            "properties": {
              "instrument_use": {
                "const": "unscored"
              }
            },
            "required": [
              "instrument_use"
            ]
          }
        },
        "required": [
          "basis"
        ]
      },
      "then": {
        "not": {
          "required": [
            "instrument_result"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "basis": {
            "type": "object",
            "not": {
              "required": [
                "instrument_use"
              ]
            }
          }
        },
        "required": [
          "basis"
        ]
      },
      "then": {
        "not": {
          "required": [
            "instrument_result"
          ]
        }
      }
    }
  ],
  "x-portia-application-invariants": [
    "portia.fidelity.canonical_storage_scope",
    "portia.fidelity.path_identity_agreement",
    "portia.fidelity.parent_support_process_resolution",
    "portia.fidelity.owner_agreement",
    "portia.fidelity.plan_ref_exact_resolution",
    "portia.fidelity.plan_ref_same_support_process",
    "portia.fidelity.plan_ref_no_silent_successor_following",
    "portia.fidelity.evaluator_ref_exact_resolution",
    "portia.fidelity.evaluator_ref_same_support_process",
    "portia.fidelity.evaluator_identity_not_authority",
    "portia.fidelity.scope_resolution",
    "portia.fidelity.scope_same_support_process",
    "portia.fidelity.scope_same_exact_plan",
    "portia.fidelity.implementation_set_identity_unique",
    "portia.fidelity.bounded_interval_chronology",
    "portia.fidelity.basis_record_refs_exact_resolution",
    "portia.fidelity.basis_record_refs_same_support_process",
    "portia.fidelity.instrument_scale_order",
    "portia.fidelity.instrument_value_within_scale",
    "portia.fidelity.source_defined_scale_only",
    "portia.fidelity.recording_chronology",
    "portia.fidelity.creation_provenance_immutable",
    "portia.fidelity.paper_activation_requires_review_history",
    "portia.fidelity.import_activation_requires_review_history",
    "portia.fidelity.lifecycle_matrix",
    "portia.fidelity.lifecycle_history_reconciliation",
    "portia.fidelity.current_use_eligibility",
    "portia.fidelity.amendment_prohibited_v1",
    "portia.fidelity.predecessor_resolution",
    "portia.fidelity.predecessor_identity_unique",
    "portia.fidelity.self_supersession",
    "portia.fidelity.supersession_reason_uniform",
    "portia.fidelity.replacement_topology",
    "portia.fidelity.supersession_cycle",
    "portia.fidelity.ownership_reconciliation",
    "portia.fidelity.incoming_reference_complete",
    "portia.fidelity.no_silent_successor_following",
    "portia.fidelity.no_effectiveness_inference",
    "portia.fidelity.no_provider_competence_inference",
    "portia.fidelity.no_student_compliance_inference",
    "portia.fidelity.no_outcome_inference",
    "portia.fidelity.no_universal_score"
  ]
}
