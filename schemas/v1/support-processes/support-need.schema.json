{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-data-suite.github.io/pds-portia/schemas/v1/support-processes/support-need.schema.json",
  "title": "Portia Support Need",
  "description": "Canonical version-1 Support Process-local Need representing one bounded teacher-local statement of a barrier, access need, skill/support need, environmental need, or other reason for support planning for one Support Process target. A Need is not a diagnosis, disability determination, behavioral-function finding, policy finding, risk score, permanent student deficit, eligibility record, or Outcome.",
  "$comment": "Application validation remains responsible for canonical path/owner agreement; parent Support Process resolution and current-use eligibility; target resolution and same-process participant ownership; logical target uniqueness; paper/import activation gates; lifecycle/history reconciliation; supersession topology; ownership correction; no silent successor following; authorization/privacy; and coordinated writes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "module_id",
    "class_id",
    "work_id",
    "need_id",
    "status",
    "target",
    "need_kind",
    "description",
    "creation_source",
    "created_at",
    "created_by",
    "updated_at",
    "updated_by"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "record_type": {
      "const": "support_need"
    },
    "module_id": {
      "const": "portia"
    },
    "class_id": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/structurally-safe-external-id.schema.json"
    },
    "work_id": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-support-process-id.schema.json"
    },
    "need_id": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-support-need-id.schema.json"
    },
    "status": {
      "enum": [
        "proposed",
        "active",
        "invalidated",
        "superseded"
      ]
    },
    "target": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/targets/support-process-target-ref.schema.json"
    },
    "need_kind": {
      "enum": [
        "access",
        "environmental_or_instructional",
        "organizational_or_routine",
        "skill_or_strategy",
        "relationship_or_connection",
        "resource_or_coordination",
        "other"
      ]
    },
    "description": {
      "allOf": [
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/non-empty-text.schema.json"
        },
        {
          "maxLength": 4000
        }
      ]
    },
    "kind_detail": {
      "allOf": [
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/non-empty-text.schema.json"
        },
        {
          "maxLength": 2000
        }
      ]
    },
    "supersedes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/supersessionEntry"
      }
    },
    "creation_source": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/provenance/creation-source.schema.json"
    },
    "created_at": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/explicit-offset-timestamp.schema.json"
    },
    "created_by": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/attribution/attribution-agent.schema.json"
    },
    "updated_at": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/explicit-offset-timestamp.schema.json"
    },
    "updated_by": {
      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/attribution/attribution-agent.schema.json"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "need_kind": {
            "const": "other"
          }
        },
        "required": [
          "need_kind"
        ]
      },
      "then": {
        "required": [
          "kind_detail"
        ]
      },
      "else": {
        "not": {
          "required": [
            "kind_detail"
          ]
        }
      }
    }
  ],
  "$defs": {
    "supportNeedWorkRecordRef": {
      "allOf": [
        {
          "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-portia-work-record-ref.schema.json"
        },
        {
          "type": "object",
          "required": [
            "work_ref",
            "record_ref"
          ],
          "properties": {
            "work_ref": {
              "allOf": [
                {
                  "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-portia-work-ref.schema.json"
                },
                {
                  "type": "object",
                  "properties": {
                    "work_kind": {
                      "const": "support_process"
                    },
                    "work_id": {
                      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-support-process-id.schema.json"
                    },
                    "contract_version": {
                      "const": "1"
                    }
                  },
                  "required": [
                    "work_kind",
                    "work_id",
                    "contract_version"
                  ]
                }
              ]
            },
            "record_ref": {
              "allOf": [
                {
                  "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/references/exact-local-record-ref.schema.json"
                },
                {
                  "type": "object",
                  "properties": {
                    "record_kind": {
                      "const": "support_need"
                    },
                    "record_id": {
                      "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/identifiers/portia-support-need-id.schema.json"
                    },
                    "contract_version": {
                      "const": "1"
                    }
                  },
                  "required": [
                    "record_kind",
                    "record_id",
                    "contract_version"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "supersessionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_record_ref",
        "reason"
      ],
      "properties": {
        "work_record_ref": {
          "$ref": "#/$defs/supportNeedWorkRecordRef"
        },
        "reason": {
          "enum": [
            "target_corrected",
            "kind_corrected",
            "description_corrected",
            "duplicate_consolidated",
            "work_root_corrected",
            "contract_migrated",
            "other"
          ]
        },
        "detail": {
          "allOf": [
            {
              "$ref": "https://paper-data-suite.github.io/pds-portia/schemas/v1/common/non-empty-text.schema.json"
            },
            {
              "maxLength": 2000
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reason": {
                "const": "other"
              }
            },
            "required": [
              "reason"
            ]
          },
          "then": {
            "required": [
              "detail"
            ]
          }
        }
      ]
    }
  },
  "x-portia-application-invariants": [
    "portia.support_need.canonical_storage_scope",
    "portia.support_need.path_identity_agreement",
    "portia.support_need.parent_support_process_resolution",
    "portia.support_need.owner_agreement",
    "portia.support_need.target_resolution",
    "portia.support_need.target_same_support_process",
    "portia.support_need.target_logical_identity_unique",
    "portia.support_need.creation_provenance_immutable",
    "portia.support_need.paper_activation_requires_review_history",
    "portia.support_need.import_activation_requires_review_history",
    "portia.support_need.lifecycle_matrix",
    "portia.support_need.lifecycle_history_reconciliation",
    "portia.support_need.predecessor_resolution",
    "portia.support_need.predecessor_identity_unique",
    "portia.support_need.self_supersession",
    "portia.support_need.supersession_reason_uniform",
    "portia.support_need.replacement_topology",
    "portia.support_need.ownership_reconciliation",
    "portia.support_need.no_silent_successor_following",
    "portia.support_need.amendment_prohibited_v1",
    "portia.support_need.no_diagnosis_inference",
    "portia.support_need.no_risk_or_function_inference",
    "portia.support_need.no_outcome_or_effectiveness"
  ]
}
